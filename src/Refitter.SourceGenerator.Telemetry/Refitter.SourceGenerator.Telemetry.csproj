<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Product>Refitter Source Generator Telemetry</Product>
        <AssemblyName>Refitter.SourceGenerator.Telemetry</AssemblyName>
        <RootNamespace>Refitter.SourceGenerator.Telemetry</RootNamespace>
        <Description>MSBuild task that reports anonymous usage telemetry for Refitter.SourceGenerator. Shipped inside the Refitter.SourceGenerator package.</Description>
        <IsPackable>false</IsPackable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Utilities.Core"
                          Version="18.9.6"
                          PrivateAssets="all"
                          ExcludeAssets="runtime"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="README.md" />
    </ItemGroup>

</Project>
