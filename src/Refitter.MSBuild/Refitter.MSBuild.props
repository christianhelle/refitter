<Project TreatAsLocalProperty="TaskFolder;TaskAssembly">

    <PropertyGroup>
        <TaskFolder>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../tasks'))</TaskFolder>
        <TaskAssembly>$([MSBuild]::NormalizePath('$(TaskFolder)/netstandard2.0/Refitter.MSBuild.dll'))</TaskAssembly>
        <RefitterVersion>$(Version)</RefitterVersion>
    </PropertyGroup>

    <UsingTask TaskName="Refitter.MSBuild.RefitterGenerateTask"
               AssemblyFile="$(TaskAssembly)" />

</Project>
