<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Product>Refitter Source Generator</Product>
    <PackageId>Refitter.SourceGenerator</PackageId>
    <AssemblyName>Refitter.SourceGenerator</AssemblyName>
    <RootNamespace>Refitter.SourceGenerator</RootNamespace>
    <Title>Refitter.SourceGenerator</Title>
    <Description>A C# Source Generator that uses Refitter for generating a REST API Client using the Refit library from OpenAPI specifications.</Description>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <NoWarn>NU1701;RF002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.Generators.Extensions" Version="1.24.2" PrivateAssets="all" />
    <PackageReference Include="NSwag.CodeGeneration.CSharp" Version="14.7.1" PrivateAssets="all" />
    <PackageReference Include="NSwag.Core.Yaml" Version="14.7.1" PrivateAssets="all" />
    <PackageReference Include="OasReader" Version="3.10.2.21" PrivateAssets="all" />
    <PackageReference Include="Refit" Version="16.4.0" PrivateAssets="all" />
    <!-- Used only by the telemetry MSBuild task, never by the generator -->
    <PackageReference Include="Microsoft.ApplicationInsights" Version="2.23.0" PrivateAssets="all" />
    <!-- Compile-time only: MSBuild provides these assemblies when it loads the telemetry task -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.11.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stop H.Generators.Extensions bundling the MSBuild assemblies next to the generator, MSBuild provides them -->
    <_SystemLibs Include="Microsoft.Build.Framework;Microsoft.Build.Utilities.Core;Microsoft.NET.StringTools" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(AssemblyName).props" Pack="true" PackagePath="build" />
    <None Include="$(AssemblyName).targets" Pack="true" PackagePath="build" />
    <Compile Include="../Refitter.Core/*.cs" />
    <Compile Include="../Refitter.Core/Abstractions/*.cs" />
    <Compile Include="../Refitter.Core/Apizr/*.cs" />
    <Compile Include="../Refitter.Core/CodeGeneration/*.cs" />
    <Compile Include="../Refitter.Core/Contracts/*.cs" />
    <Compile Include="../Refitter.Core/Document/*.cs" />
    <Compile Include="../Refitter.Core/Generation/*.cs" />
    <Compile Include="../Refitter.Core/Mutators/*.cs" />
    <Compile Include="../Refitter.Core/ParameterExtraction/*.cs" />
    <Compile Include="../Refitter.Core/Partitioning/*.cs" />
    <Compile Include="../Refitter.Core/Pipeline/*.cs" />
    <Compile Include="../Refitter.Core/Schema/*.cs" />
    <Compile Include="../Refitter.Core/Settings/*.cs" />
    <Compile Include="../Refitter.Core/Utilities/*.cs" />
    <Compile Include="../Refitter.Core/Validation/*.cs" />
  </ItemGroup>

</Project>
