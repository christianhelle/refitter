<Project>

  <!--
  Refit's source generator runs against the same input compilation as Refitter, so it cannot see the
  Refit interfaces that Refitter generates. Refitter therefore disables the consumer's Refit generator
  and runs that same generator itself over the project sources plus the Refitter output.

  This has to be a .targets file so that a DisableRefitSourceGenerator value set in the project body
  (for example when using Refit.Reflection) is respected: in that case Refit generation stays off.
  -->
  <PropertyGroup Condition="'$(DisableRefitSourceGenerator)' != 'true'">
    <RefitterRunsRefitGenerator>true</RefitterRunsRefitGenerator>
    <DisableRefitSourceGenerator>true</DisableRefitSourceGenerator>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RefitterRunsRefitGenerator" />
  </ItemGroup>

  <!--
  Anonymous usage telemetry runs as an MSBuild task after the build, never inside the source generator,
  so the compiler and IDE never make network calls. It is skipped in design-time builds, only sends when
  the .refitter files change (tracked with a stamp file in obj), uses a short timeout and never fails the
  build. Opt out with <RefitterNoLogging>true</RefitterNoLogging> or DOTNET_CLI_TELEMETRY_OPTOUT=1.
  -->
  <PropertyGroup>
    <_RefitterTelemetryTaskAssembly>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../tasks/netstandard2.0/Refitter.SourceGenerator.Telemetry.dll'))</_RefitterTelemetryTaskAssembly>
  </PropertyGroup>

  <UsingTask TaskName="Refitter.SourceGenerator.Telemetry.RefitterTelemetryTask"
             AssemblyFile="$(_RefitterTelemetryTaskAssembly)"
             Condition="Exists('$(_RefitterTelemetryTaskAssembly)')" />

  <Target Name="_RefitterSourceGeneratorTelemetry"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(RefitterNoLogging)' != 'true' and Exists('$(_RefitterTelemetryTaskAssembly)')">
    <ItemGroup>
      <_RefitterTelemetrySettingsFile Include="@(AdditionalFiles)" Condition="'%(Extension)' == '.refitter'" />
    </ItemGroup>
    <RefitterTelemetryTask SettingsFiles="@(_RefitterTelemetrySettingsFile)"
                           StampFile="$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'refitter.sourcegenerator.telemetry'))"
                           DesignTimeBuild="$(DesignTimeBuild)"
                           DisableLogging="$(RefitterNoLogging)"
                           TelemetryOptOut="$(DOTNET_CLI_TELEMETRY_OPTOUT)"
                           ContinueOnError="true" />
  </Target>

</Project>
