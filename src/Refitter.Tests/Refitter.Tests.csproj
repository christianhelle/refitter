<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
      <None Remove="Resources\V2\SwaggerPetstoreWithDifferentHeaders.json" />
      <None Remove="Resources\V2\SwaggerPetstoreWithDifferentHeaders.yaml" />
      <None Remove="Resources\V3\SwaggerPetstoreWithDifferentHeaders.json" />
      <None Remove="Resources\V3\SwaggerPetstoreWithDifferentHeaders.yaml" />
      <None Remove="README.md" />
      <None Update="Templates\Class.Annotations.liquid">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.9.6" PrivateAssets="all" />
        <PackageReference Include="Refit" Version="16.4.0" GeneratePathProperty="true" />
        <PackageReference Include="Refit.Reflection" Version="16.4.0" />
        <PackageReference Include="TUnit" Version="1.71.0" />
        <PackageReference Include="coverlet.collector" Version="10.1.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <!-- Lets RefitRequestCapture run Refit's compile-time client generator on in-memory compilations -->
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>RefitInterfaceStubGenerator</_Parameter1>
        <_Parameter2>$([System.IO.Path]::Combine($(PkgRefit), 'analyzers', 'dotnet', 'roslyn4.8', 'cs', 'InterfaceStubGeneratorV2.dll'))</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Resources\**\*.json" />
      <EmbeddedResource Include="Resources\**\*.yaml" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Refitter.Core\Refitter.Core.csproj" />
      <ProjectReference Include="..\Refitter\Refitter.csproj" />
      <ProjectReference Include="..\Refitter.MSBuild\Refitter.MSBuild.csproj" />
    </ItemGroup>

</Project>
