        /// <param name="orderFromDate">Search by OrderFromDate date(yyyy-MM-dd).</param>
        /// <param name="orderToDate">Search by OrderToDate date(yyyy-MM-dd).</param>
        /// <param name="orderNumber">Search by order number</param>
        /// <param name="deliveryNumber">Search by delivery number.</param>
        /// <param name="invoiceNumber">The Ingram Micro invoice number.</param>
        /// <param name="invoiceStatus">Ingram Micro invoice status.</param>
