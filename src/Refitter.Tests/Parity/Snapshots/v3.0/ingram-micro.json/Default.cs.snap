        [Headers("Accept: application/json")]
        [Get("/resellers/v6/invoices/")]
        Task<InvoiceSearchResponse> InvoicesGet([Query, AliasAs("PaymentTermsNetDate")] string paymentTermsNetDate, [Query, AliasAs("InvoiceDate")] string invoiceDate, [Query, AliasAs("InvoiceDueDate")] string invoiceDueDate, [Query, AliasAs("OrderDate")] string orderDate, [Query, AliasAs("OrderFromDate")] string orderFromDate, [Query, AliasAs("OrderToDate")] string orderToDate, [Query, AliasAs("OrderNumber")] string orderNumber, [Query, AliasAs("DeliveryNumber")] string deliveryNumber, [Query, AliasAs("InvoiceNumber")] string invoiceNumber, [Query, AliasAs("InvoiceStatus")] string invoiceStatus, [Query, AliasAs("InvoiceType")] string invoiceType, [Query, AliasAs("CustomerOrderNumber")] string customerOrderNumber, [Query, AliasAs("EndCustomerOrderNumber")] string endCustomerOrderNumber, [Query, AliasAs("SpecialBidNumber")] string specialBidNumber, [Query, AliasAs("InvoiceFromDueDate")] string invoiceFromDueDate, [Query, AliasAs("InvoiceToDueDate")] string invoiceToDueDate, [Query, AliasAs("InvoiceFromDate")] string invoiceFromDate, [Query, AliasAs("InvoiceToDate")] string invoiceToDate, [Query] int? pageSize, [Query] int? pageNumber, [Query, AliasAs("Orderby")] string orderby, [Query, AliasAs("Direction")] string direction, [Header("IM-ApplicationID ")] string iM_ApplicationID_, [Header("IM-CustomerNumber")] string iM_CustomerNumber, [Header("IM-CountryCode")] string iM_CountryCode, [Header("IM-CorrelationID")] string iM_CorrelationID);

        /// <summary>Get Invoice Details</summary>
