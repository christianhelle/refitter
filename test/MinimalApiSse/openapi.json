{
  "openapi": "3.2.0",
  "info": {
    "title": "Program | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Program"
        ],
        "operationId": "MyStreamEndpoint",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "required": [
                    "data"
                  ],
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/MyStreamData"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MyStreamData": {
        "required": [
          "message",
          "index"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "index": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Program"
    }
  ]
