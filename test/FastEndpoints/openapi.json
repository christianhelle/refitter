{
    "openapi": "3.2.0",
    "info": {
        "title": "Program | v1",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:5000"
        }
    ],
    "paths": {
        "/": {
            "get": {
                "operationId": "MyStreamEndpoint",
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "text/event-stream": {
                                "itemSchema": {
                                    "required": ["data"],
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/MyStreamData"
                                        },
                                        "event": {
                                            "type": "string"
                                        },
                                        "id": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "JWTBearerAuth": {
                "type": "http",
                "description": "Enter a JWT token to authorize the requests...",
                "scheme": "Bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}
