<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Refitter.MSBuild comes from the package packed into this folder by build.ps1/build.sh,
       everything else (Refit, Microsoft.Extensions.*) from nuget.org -->
  <packageSources>
    <clear />
    <add key="local" value="." />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Refitter.MSBuild" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
