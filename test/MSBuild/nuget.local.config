<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Passed explicitly by build.ps1/build.sh rather than auto-discovered, so the production-tests
       workflow still restores the published package from nuget.org. Refitter.MSBuild comes from the
       package packed into this folder, everything else (Refit, Microsoft.Extensions.*) from nuget.org -->
  <packageSources>
    <clear />
    <add key="local" value="." />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Refitter.MSBuild" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
