{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "FluentAssertions 8.x is under a commercial license; use the Apache-2.0 fork",
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": [
        "FluentAssertions"
      ],
      "replacementName": "AwesomeAssertions",
      "replacementVersion": "9.6.0"
    },
    {
      "description": ".NET 11 packages don't support net8.0 or net9.0, so keep the references for those target frameworks on 10.x",
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": [
        "System.Text.Json",
        "Microsoft.Extensions.Http.Polly"
      ],
      "matchCurrentVersion": "/^10\\./",
      "allowedVersions": "/^10\\./"
    }
  ]
}
